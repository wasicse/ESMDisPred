Bootstrap: docker
From: python:3.10-slim

%help
    Singularity container for ESMDisPred — Structure-Aware CNN-Transformer
    Framework for Intrinsically Disordered Protein Prediction.

    Run:
        singularity exec esmdispred.sif /opt/ESMDisPred/run_ESMDisPred.sh \
            input.fasta output_dir [model_option]

%environment
    export ESMpath=/opt/ESMDisPred
    export TORCH_HOME=/opt/ESMDisPred/largeModels
    export PATH=/opt/ESMDisPred/.venv/bin:/usr/local/bin:$PATH

%post
    apt-get update && apt-get install -y --no-install-recommends \
        make build-essential libssl-dev wget curl git nano tcsh \
        openjdk-11-jre libidn11 libidn12 llvm \
    && rm -rf /var/lib/apt/lists/*

    # Ensure libidn.so.11 exists — bundled psiblast requires it
    libpath=$(find /usr/lib /lib -name "libidn.so.12" 2>/dev/null | head -1)
    [ -n "$libpath" ] && ln -fs "$libpath" "$(dirname "$libpath")/libidn.so.11" && ldconfig || true

    # Install UV system-wide
    curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh

    # Clone and install ESMDisPred
    cd /opt
    git clone https://github.com/wasicse/ESMDisPred.git
    chmod -R 755 /opt/ESMDisPred

    cd /opt/ESMDisPred
    ./install_dependencies.sh

%runscript
    cd /opt/ESMDisPred
    exec /bin/bash "$@"
